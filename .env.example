# 复制为 .env 后填写真实密钥；修改配置后重启服务。
# 文档入库需要向量接口；对话模型可单独配置。
KNOWLEDGE_BACKEND=postgres
POSTGRES_RUNTIME=docker
# 本地 Docker Compose 示例；请将下面两处密码换成相同的随机密码。
POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgresql://power_agent:replace-with-a-random-password@127.0.0.1:55432/power_agent
DATABASE_SCHEMA=power_agent
EMBEDDING_BASE_URL=https://api.302.ai/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# 留空时使用 LLM_API_KEY。
EMBEDDING_API_KEY=
VECTOR_MIN_SIMILARITY=0.3
# 使用兼容 Chat Completions JSON 协议的模型服务，填写完整接口 URL。
# 本地服务示例（需自行运行服务并准备模型）：
# LLM_API_URL=http://127.0.0.1:11434/v1/chat/completions
# LLM_MODEL=your-installed-model
# 云端地址必须使用 HTTPS。不要把真实密钥写入代码或提交到仓库。
LLM_API_URL=https://api.302.ai/v1/chat/completions
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# 最多生成的 token 数量（128～16000）；数值越高，潜在输出费用越高。
LLM_MAX_TOKENS=2000
# 回答随机性（0～2），知识问答建议较低值。
LLM_TEMPERATURE=0.2
